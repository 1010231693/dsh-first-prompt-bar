{
  "name": "dsh-first-prompt-bar",
  "version": "0.7.0",
  "description": "Persistent bar above the conversation showing the session's first prompt, with copy, a panel of every prompt sent, and eight switchable looks · 会话首条提问常驻条：复制 + 全部提问面板 + 八套可切换外观",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "cordis.patch.yml", "README.md", "README.zh.md"],
  "keywords": ["deepseek-harness", "dsh-plugin", "prompt", "clipboard", "首条提问"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1010231693/dsh-first-prompt-bar.git"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
